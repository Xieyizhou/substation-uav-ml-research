{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study_result.schema.json",
  "title": "Research Study Run Result",
  "type": "object",
  "required": ["schema_version", "run_id", "scenario_id", "condition", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "scenario_id": {"type": "string"},
    "condition": {
      "enum": [
        "champion",
        "candidate",
        "map_oracle",
        "geometric_lidar",
        "ml_lidar",
        "geometric_ml_fusion"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": ["number", "integer", "null"]}
    },
    "artifacts": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
