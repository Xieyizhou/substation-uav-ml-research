{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_model_identity.schema.json",
  "title": "Visual Model Identity",
  "type": "object",
  "required": [
    "identity_schema_version",
    "model_family",
    "architecture_variant",
    "task",
    "class_order_identity",
    "input_width",
    "input_height",
    "input_pixel_format",
    "preprocessing_configuration_id",
    "runtime_backend",
    "precision",
    "weights_sha256",
    "model_file_sha256",
    "model_package_schema_version",
    "training_dataset_identity",
    "training_code_commit_sha",
    "export_configuration_identity",
    "onnx_opset",
    "runtime_version_identity",
    "model_identity_sha256"
  ],
  "properties": {
    "identity_schema_version": {"const": 1},
    "model_family": {"type": "string", "minLength": 1},
    "architecture_variant": {"type": "string", "minLength": 1},
    "task": {"type": "string", "minLength": 1},
    "class_order_identity": {"$ref": "#/$defs/sha256"},
    "input_width": {"type": "integer", "minimum": 1},
    "input_height": {"type": "integer", "minimum": 1},
    "input_pixel_format": {"const": "rgb8"},
    "preprocessing_configuration_id": {"$ref": "#/$defs/sha256"},
    "runtime_backend": {"type": "string", "minLength": 1},
    "precision": {"type": "string", "minLength": 1},
    "weights_sha256": {"$ref": "#/$defs/sha256"},
    "model_file_sha256": {"$ref": "#/$defs/sha256"},
    "model_package_schema_version": {"type": "integer", "minimum": 1},
    "training_dataset_identity": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "training_code_commit_sha": {"type": ["string", "null"]},
    "export_configuration_identity": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "onnx_opset": {"type": ["integer", "null"], "minimum": 1},
    "runtime_version_identity": {"type": "string", "minLength": 1},
    "model_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
