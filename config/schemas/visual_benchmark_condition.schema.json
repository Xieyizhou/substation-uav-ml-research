{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_benchmark_condition.schema.json",
  "title": "Materialized Static Visual Benchmark Condition",
  "type": "object",
  "required": [
    "condition_schema_version",
    "condition_id",
    "dataset_identity_sha256",
    "decoder_configuration_id",
    "preprocessing_configuration_id",
    "model_identity_sha256",
    "input_width",
    "input_height",
    "inference_policy",
    "frame_skip_interval",
    "confidence_threshold",
    "target_inference_rate_hz",
    "roi_mode",
    "batch_size",
    "warmup_frame_count",
    "measured_frame_count",
    "runtime_backend",
    "device_identity",
    "precision",
    "deadline_definition",
    "random_seed",
    "software_commit_sha",
    "condition_identity_sha256"
  ],
  "properties": {
    "condition_schema_version": {"const": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "dataset_identity_sha256": {"$ref": "#/$defs/sha256"},
    "decoder_configuration_id": {"$ref": "#/$defs/sha256"},
    "preprocessing_configuration_id": {"$ref": "#/$defs/sha256"},
    "model_identity_sha256": {"$ref": "#/$defs/sha256"},
    "input_width": {"type": "integer", "minimum": 1},
    "input_height": {"type": "integer", "minimum": 1},
    "inference_policy": {"enum": ["every_frame", "every_nth_frame"]},
    "frame_skip_interval": {"type": "integer", "minimum": 1},
    "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
    "target_inference_rate_hz": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "roi_mode": {"const": "disabled"},
    "batch_size": {"type": "integer", "minimum": 1},
    "warmup_frame_count": {"type": "integer", "minimum": 0},
    "measured_frame_count": {"type": "integer", "minimum": 1},
    "runtime_backend": {"type": "string", "minLength": 1},
    "device_identity": {"type": "string", "minLength": 1},
    "precision": {"type": "string", "minLength": 1},
    "deadline_definition": {"type": "string", "minLength": 1},
    "random_seed": {"type": ["integer", "null"], "minimum": 0},
    "software_commit_sha": {"type": "string", "minLength": 1},
    "condition_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
