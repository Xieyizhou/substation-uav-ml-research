<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_research">
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <link name="research_lidar_link">
      <pose relative_to="base_link">-0.1 0 0.26 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <iyy>0.00005</iyy>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry>
          <cylinder><radius>0.03</radius><length>0.06</length></cylinder>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <sensor name="lidar_2d_v2" type="gpu_lidar">
        <gz_frame_id>research_lidar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>1080</samples>
              <resolution>1</resolution>
              <min_angle>-2.356195</min_angle>
              <max_angle>2.356195</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.001</stddev>
          </noise>
        </ray>
        <always_on>false</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="research_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>research_lidar_link</child>
    </joint>

    <link name="research_camera_link">
      <pose relative_to="base_link">0.18 0 0.12 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry>
          <box><size>0.04 0.06 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <sensor name="research_rgb" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>research_camera/image</topic>
        <camera>
          <horizontal_fov>1.466</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>120</far>
          </clip>
        </camera>
      </sensor>
      <sensor name="research_boxes" type="boundingbox_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>research_camera/boxes</topic>
        <camera>
          <horizontal_fov>1.466</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>120</far>
          </clip>
          <box_type>full_2d</box_type>
        </camera>
      </sensor>
    </link>
    <joint name="research_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>research_camera_link</child>
    </joint>
  </model>
</sdf>
